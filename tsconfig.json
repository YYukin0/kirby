{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "ui",
    "rootDir": "ui",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["ui/main.ts", "ui/plan.ts"],
  "exclude": ["node_modules", "src-tauri"]
}
